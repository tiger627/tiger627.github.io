---
import type { CollectionEntry } from "astro:content";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;

// Group posts by first tag
const grouped: Record<string, CollectionEntry<"posts">[]> = {};
for (const post of posts) {
  const tag = post.data.tags?.[0] ?? "Uncategorized";
  if (!grouped[tag]) grouped[tag] = [];
  grouped[tag].push(post);
}
const tags = Object.keys(grouped).sort();
---

<nav class="tag-tree">
  <p class="tree-heading">Categories</p>
  <ul class="tree-list">
    {tags.map(tag => (
      <li>
        <details open>
          <summary>
            <span class="tag-name">{tag}</span>
            <span class="tag-count">({grouped[tag].length})</span>
          </summary>
          <ul class="post-list">
            {grouped[tag].map(post => (
              <li>
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tag-tree {
    width: 220px;
    flex-shrink: 0;
    position: sticky;
    top: 5rem;
    align-self: flex-start;
    padding: 1rem 1rem 1rem 0;
    border-right: 1px solid var(--color-border, #e5e7eb);
    margin-right: 2rem;
  }

  .tree-heading {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .tree-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  details > summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  details > summary::-webkit-details-marker { display: none; }

  details > summary::before {
    content: "▶";
    font-size: 0.55rem;
    opacity: 0.4;
    transition: transform 0.15s;
    flex-shrink: 0;
  }

  details[open] > summary::before {
    transform: rotate(90deg);
  }

  .tag-count {
    font-size: 0.75rem;
    opacity: 0.45;
    font-weight: 400;
  }

  .post-list {
    list-style: none;
    padding: 0.25rem 0 0.25rem 1.1rem;
    margin: 0;
    border-left: 2px solid currentColor;
    opacity: 0.3;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .post-list a {
    display: block;
    font-size: 0.78rem;
    line-height: 1.4;
    padding: 0.15rem 0.4rem;
    text-decoration: none;
    opacity: 1;
    border-radius: 3px;
    transition: background 0.1s;
  }

  .post-list a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .tag-tree {
      width: 100%;
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--color-border, #e5e7eb);
      margin-right: 0;
      margin-bottom: 1.5rem;
      padding: 0 0 1rem 0;
    }
  }
</style>
